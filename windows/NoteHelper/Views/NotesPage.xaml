<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NoteHelper.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NoteHelper.Views"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="BackButton_Click"
                    Style="{StaticResource SubtleButtonStyle}" Padding="8">
                <FontIcon Glyph="&#xE72B;" FontSize="16"/>
            </Button>

            <TextBlock x:Name="MeetingTitle" Grid.Column="1"
                       Text="Meeting Notes"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button Click="GenerateSummary_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE945;" FontSize="14"/>
                        <TextBlock Text="Summarize"/>
                    </StackPanel>
                </Button>
                <Button Click="ExportNotes_Click" Padding="8"
                        ToolTipService.ToolTip="Export">
                    <FontIcon Glyph="&#xE72D;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Meeting metadata -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE787;" FontSize="12"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="MeetingDate" Text="--"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon Glyph="&#xE823;" FontSize="12"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="MeetingDuration" Text="--"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Content area: Summary + Transcript -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!-- AI Summary Section -->
                <muxc:Expander x:Name="SummaryExpander"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Stretch"
                               IsExpanded="True">
                    <muxc:Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE945;" FontSize="14"/>
                            <TextBlock Text="AI Summary" FontWeight="SemiBold"/>
                        </StackPanel>
                    </muxc:Expander.Header>
                    <muxc:Expander.Content>
                        <Grid MinHeight="80">
                            <muxc:ProgressRing x:Name="SummaryProgress"
                                               IsActive="False"
                                               Width="24" Height="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                            <TextBlock x:Name="SummaryText"
                                       Text="No summary generated yet. Click 'Summarize' to generate."
                                       TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </muxc:Expander.Content>
                </muxc:Expander>

                <!-- Key Points -->
                <muxc:Expander x:Name="KeyPointsExpander"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Stretch"
                               IsExpanded="True"
                               Visibility="Collapsed">
                    <muxc:Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8FD;" FontSize="14"/>
                            <TextBlock Text="Key Points" FontWeight="SemiBold"/>
                        </StackPanel>
                    </muxc:Expander.Header>
                    <muxc:Expander.Content>
                        <ItemsRepeater x:Name="KeyPointsList">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid Padding="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#x2022;"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind}"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </muxc:Expander.Content>
                </muxc:Expander>

                <!-- Action Items -->
                <muxc:Expander x:Name="ActionItemsExpander"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Stretch"
                               IsExpanded="True"
                               Visibility="Collapsed">
                    <muxc:Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73A;" FontSize="14"/>
                            <TextBlock Text="Action Items" FontWeight="SemiBold"/>
                        </StackPanel>
                    </muxc:Expander.Header>
                    <muxc:Expander.Content>
                        <ItemsRepeater x:Name="ActionItemsList">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid Padding="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Margin="0,0,4,0"
                                                  MinWidth="0"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   IsTextSelectionEnabled="True"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </muxc:Expander.Content>
                </muxc:Expander>

                <!-- Decisions -->
                <muxc:Expander x:Name="DecisionsExpander"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Stretch"
                               IsExpanded="True"
                               Visibility="Collapsed">
                    <muxc:Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7C1;" FontSize="14"/>
                            <TextBlock Text="Decisions" FontWeight="SemiBold"/>
                        </StackPanel>
                    </muxc:Expander.Header>
                    <muxc:Expander.Content>
                        <ItemsRepeater x:Name="DecisionsList">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid Padding="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#x25B8;"
                                                   Margin="0,0,8,0" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind}"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </muxc:Expander.Content>
                </muxc:Expander>

                <!-- Full Transcript -->
                <muxc:Expander HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Stretch"
                               IsExpanded="False">
                    <muxc:Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F2;" FontSize="14"/>
                            <TextBlock Text="Full Transcript" FontWeight="SemiBold"/>
                        </StackPanel>
                    </muxc:Expander.Header>
                    <muxc:Expander.Content>
                        <TextBlock x:Name="TranscriptText"
                                   Text="No transcript available."
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   FontFamily="Cascadia Code, Consolas, monospace"
                                   FontSize="13"
                                   LineHeight="20"/>
                    </muxc:Expander.Content>
                </muxc:Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
