<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NoteHelper.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NoteHelper.Views"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4" MaxWidth="800">

            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,16"/>

            <!-- Audio Section -->
            <TextBlock Text="Audio" Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,8"/>

            <Grid Padding="16" CornerRadius="8"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                    <TextBlock Text="Input Device" FontWeight="SemiBold"/>
                    <TextBlock Text="Select the microphone to use for recording."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="AudioDeviceCombo"
                              HorizontalAlignment="Stretch"
                              Margin="0,8,0,0"
                              PlaceholderText="Default System Microphone"
                              SelectionChanged="AudioDeviceCombo_SelectionChanged"/>
                    <Button Content="Refresh Devices" Margin="0,4,0,0"
                            Click="RefreshDevices_Click"
                            Style="{StaticResource SubtleButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="4">
                    <TextBlock Text="System Audio Capture" FontWeight="SemiBold"/>
                    <TextBlock Text="Capture system audio (loopback) in addition to microphone input."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ToggleSwitch x:Name="LoopbackToggle"
                                  OffContent="Disabled" OnContent="Enabled"
                                  Toggled="LoopbackToggle_Toggled"
                                  Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Transcription Section -->
            <TextBlock Text="Transcription" Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,24,0,8"/>

            <Grid Padding="16" CornerRadius="8"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mode toggle -->
                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                    <TextBlock Text="Transcription Mode" FontWeight="SemiBold"/>
                    <muxc:RadioButtons x:Name="TranscriptionMode"
                                       SelectionChanged="TranscriptionMode_SelectionChanged">
                        <RadioButton Content="Local (Whisper)" Tag="local"/>
                        <RadioButton Content="Cloud (OpenAI Whisper API)" Tag="cloud"/>
                    </muxc:RadioButtons>
                </StackPanel>

                <!-- Model selection -->
                <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,16">
                    <TextBlock Text="Whisper Model" FontWeight="SemiBold"/>
                    <TextBlock Text="Larger models are more accurate but slower and use more memory."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="ModelCombo"
                              HorizontalAlignment="Stretch"
                              Margin="0,8,0,0"
                              SelectionChanged="ModelCombo_SelectionChanged">
                        <ComboBoxItem Content="Tiny (~75 MB)" Tag="tiny"/>
                        <ComboBoxItem Content="Base (~142 MB)" Tag="base"/>
                        <ComboBoxItem Content="Small (~466 MB)" Tag="small"/>
                        <ComboBoxItem Content="Medium (~1.5 GB)" Tag="medium"/>
                    </ComboBox>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <muxc:ProgressBar x:Name="ModelDownloadProgress"
                                          Grid.Column="0"
                                          Visibility="Collapsed"
                                          IsIndeterminate="True"/>
                        <Button x:Name="DownloadModelButton"
                                Grid.Column="1"
                                Content="Download"
                                Click="DownloadModel_Click"
                                Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Language -->
                <StackPanel Grid.Row="2" Spacing="4">
                    <TextBlock Text="Language" FontWeight="SemiBold"/>
                    <ComboBox x:Name="LanguageCombo"
                              HorizontalAlignment="Stretch"
                              Margin="0,8,0,0"
                              PlaceholderText="Auto-detect"
                              SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Content="Auto-detect" Tag="auto"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                        <ComboBoxItem Content="Spanish" Tag="es"/>
                        <ComboBoxItem Content="French" Tag="fr"/>
                        <ComboBoxItem Content="German" Tag="de"/>
                        <ComboBoxItem Content="Japanese" Tag="ja"/>
                        <ComboBoxItem Content="Chinese" Tag="zh"/>
                        <ComboBoxItem Content="Korean" Tag="ko"/>
                        <ComboBoxItem Content="Portuguese" Tag="pt"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- API Keys Section -->
            <TextBlock Text="API Keys" Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,24,0,8"/>

            <Grid Padding="16" CornerRadius="8"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                    <TextBlock Text="OpenAI API Key" FontWeight="SemiBold"/>
                    <TextBlock Text="Used for cloud transcription. Your key is stored securely in Windows Credential Manager."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <PasswordBox x:Name="OpenAIKeyBox"
                                 PlaceholderText="sk-..."
                                 Margin="0,8,0,0"
                                 PasswordChanged="OpenAIKeyBox_PasswordChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="4">
                    <TextBlock Text="Anthropic API Key" FontWeight="SemiBold"/>
                    <TextBlock Text="Used for meeting summarization with Claude. Stored in Credential Manager."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <PasswordBox x:Name="AnthropicKeyBox"
                                 PlaceholderText="sk-ant-..."
                                 Margin="0,8,0,0"
                                 PasswordChanged="AnthropicKeyBox_PasswordChanged"/>
                </StackPanel>
            </Grid>

            <!-- Data Management -->
            <TextBlock Text="Data" Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,24,0,8"/>

            <Grid Padding="16" CornerRadius="8"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  Margin="0,0,0,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                    <TextBlock Text="Storage Location" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StoragePathText"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextSelectionEnabled="True"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                            Margin="0,0,0,12">
                    <Button Content="Export All Meetings" Click="ExportAll_Click"/>
                    <Button Content="Open Data Folder" Click="OpenDataFolder_Click"
                            Style="{StaticResource SubtleButtonStyle}"/>
                </StackPanel>

                <Button Grid.Row="2"
                        Content="Clear All Data"
                        Click="ClearData_Click"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
